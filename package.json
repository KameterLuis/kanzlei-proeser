{
  "name": "steuerkanzlei-proeser",
  "version": "1.0.0",
  "private": true,
  "description": "Website der Steuerkanzlei Wolfgang Pröser, Kaiserslautern",
  "scripts": {
    "postinstall": "node scripts/fetch-images.mjs",
    "images": "node scripts/fetch-images.mjs",
    "optimize-images": "node scripts/optimize-images.mjs",
    "predev": "node scripts/optimize-images.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/optimize-images.mjs",
    "build": "next build",
    "preview": "npx --yes serve@14 out",
    "deploy": "npm run build && wrangler pages deploy out --project-name steuerkanzlei-proeser --branch main",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/source-sans-3": "^5.2.8",
    "@fontsource/source-serif-4": "^5.2.9",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.6",
    "sharp": "^0.35.5",
    "typescript": "^5",
    "wrangler": "^4.164.0"
  },
  "engines": {
    "node": ">=20.9"
  }
}
